/* LupuS Software Center - Polkit authorization rules
 * Allows users in active sessions or administrative groups to install, upgrade,
 * and remove Luppo and Flatpak packages without password prompt.
 */
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.policykit.exec" &&
         (action.lookup("program") == "/usr/bin/luppo" ||
          action.lookup("program") == "/usr/bin/lupus-software-center" ||
          action.lookup("program") == "/usr/bin/flatpak")) ||
        action.id.indexOf("tr.org.luppo") === 0 ||
        action.id.indexOf("org.freedesktop.Flatpak") === 0 ||
        action.id.indexOf("org.freedesktop.packagekit") === 0) {
        return polkit.Result.YES;
    }
});
