{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiSiM",
  "version": "2.0.0",
  "identifier": "com.antolun.pisim",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PiSiM - PiSi Market",
        "width": 1400,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "/**",
          "/usr/**",
          "/var/**",
          "/home/**",
          "/opt/**",
          "/tmp/**"
        ]
      }
    },
    "trayIcon": {
      "title": "PiSiM",
      "iconPath": "icons/128x128.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
