<?xml version="1.0" ?>
<!DOCTYPE PISI SYSTEM "https://www.pisilinux.org/projeler/pisi/pisi-spec.dtd">
<PISI>
    <Source>
        <Name>pisim</Name>
        <Homepage>https://github.com/TeknoAnka/pisim</Homepage>
        <Packager>
            <Name>Solzic0</Name>
            <Email>solzic0@yandex.com</Email>
        </Packager>
        <License>GPLv3</License>
        <IsA>app:gui</IsA>
        <Summary>PiSi Market - Modern Software Center for LupuS</Summary>
        <Description>PiSiM (PiSi Market) is a modern, high-performance Software Center built with PyQt6 for the LupuS Operating System, supporting native PiSi package management and Flatpak applications.</Description>
    </Source>

    <Package>
        <Name>pisim</Name>
        <RuntimeDependencies>
            <Dependency>python3</Dependency>
            <Dependency>python3-pyqt6</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="executable">/usr/bin/pisim</Path>
            <Path fileType="data">/usr/share/pisim</Path>
            <Path fileType="data">/usr/share/applications/com.teknoanka.pisim.desktop</Path>
            <Path fileType="data">/usr/share/icons/hicolor/128x128/apps/pisim.png</Path>
            <Path fileType="doc">/usr/share/doc/pisim</Path>
        </Files>
    </Package>

    <History>
        <Update release="1">
            <Date>2026-08-09</Date>
            <Version>1.2.0</Version>
            <Comment>PiSiM package release</Comment>
            <Name>Solzic0</Name>
            <Email>solzic0@yandex.com</Email>
        </Update>
    </History>
</PISI>
