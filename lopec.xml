        <IsA>app:gui</IsA>
        <Summary>LupuS Software Center - Luppo Market</Summary>
        <Description>LupuS Software Center is a modern, fast and lightweight package manager and application store for the LupuS operating system.</Description>
    </Source>

    <Package>
        <Name>lupus-software-center</Name>
        <RuntimeDependencies>
            <Dependency>rust</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="executable">/usr/bin/lupus-software-center</Path>
            <Path fileType="data">/usr/share/applications/lupus-software-center.desktop</Path>
            <Path fileType="data">/usr/share/icons/hicolor/128x128/apps/lupus-software-center.png</Path>
            <Path fileType="config">/etc/udev/rules.d/99-lupus-software-center.rules</Path>
            <Path fileType="data">/usr/share/polkit-1/rules.d/50-lupus-software-center.rules</Path>
            <Path fileType="data">/usr/share/polkit-1/actions/tr.org.luppo.softwarecenter.policy</Path>
            <Path fileType="config">/etc/sudoers.d/50-lupus-software-center</Path>
            <Path fileType="doc">/usr/share/doc/lupus-software-center</Path>
        </Files>
    </Package>

